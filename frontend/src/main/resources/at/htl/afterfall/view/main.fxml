<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="at.htl.afterfall.controller.MainController"
      style="-fx-background-color: #0c0d18;"
      spacing="0">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 28 36 20 36; -fx-background-color: #0e0f1e;">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="AFTERFALL"
                   style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: white;
                          -fx-effect: dropshadow(gaussian, rgba(100,181,246,0.35), 16, 0, 0, 0);"/>
            <Label text="U-Bahn Manager"
                   style="-fx-font-size: 13; -fx-text-fill: #546e7a;"/>
        </VBox>
        <Label fx:id="statusLabel" text=""
               style="-fx-text-fill: #90a4ae; -fx-font-size: 12;"/>
    </HBox>

    <Line startX="0" endX="1000" stroke="#1a1d2e" strokeWidth="1"/>

    <!-- Body: 2 Spalten -->
    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- Linke Spalte: Saves -->
        <VBox spacing="14" style="-fx-padding: 28 28 28 36; -fx-background-color: #0c0d18;"
              prefWidth="540" HBox.hgrow="ALWAYS">

            <!-- Neues Spiel -->
            <Button text="＋  Neues Spiel" onAction="#onNewGame"
                    maxWidth="Infinity" prefHeight="52"
                    style="-fx-background-color: #1b5e20; -fx-text-fill: white;
                           -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-background-radius: 10;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 8, 0, 0, 2);"/>

            <Label text="Gespeicherte Spielstände"
                   style="-fx-text-fill: #37474f; -fx-font-size: 11; -fx-padding: 6 0 2 2;"/>

            <ListView fx:id="saveListView"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #13141f; -fx-border-color: #1e2030;
                             -fx-border-radius: 8; -fx-background-radius: 8;"/>

            <HBox spacing="10">
                <Button fx:id="loadBtn" text="Laden" onAction="#onLoad"
                        prefHeight="42" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        style="-fx-background-color: #0d47a1; -fx-text-fill: white;
                               -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;"/>
                <Button fx:id="deleteBtn" text="Löschen" onAction="#onDelete"
                        prefHeight="42" prefWidth="120"
                        style="-fx-background-color: #b71c1c; -fx-text-fill: white;
                               -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 8;"/>
            </HBox>
        </VBox>

        <!-- Trennlinie vertikal -->
        <Rectangle width="1" fill="#1a1d2e"/>

        <!-- Rechte Spalte: Rangliste -->
        <VBox spacing="10" style="-fx-padding: 28 36 28 28; -fx-background-color: #0b0c17;"
              prefWidth="460">

            <Label text="🏆  Globale Rangliste"
                   style="-fx-text-fill: #c8c8d8; -fx-font-size: 14; -fx-font-weight: bold;"/>

            <ListView fx:id="rankingListView"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: #1e2237;
                             -fx-border-radius: 8; -fx-background-radius: 8;"/>

            <Label fx:id="rankingStatusLabel" text="Lade Rangliste..."
                   style="-fx-text-fill: #37474f; -fx-font-size: 11;"/>
        </VBox>
    </HBox>

</VBox>
