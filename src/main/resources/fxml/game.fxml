<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.metrobuilder.controller.GameController"
            style="-fx-background-color: #1a1a2e;">

    <!-- Map area -->
    <center>
        <StackPane style="-fx-background-color: #0d0d1a;">
            <Label text="[Map — Task 2]"
                   style="-fx-text-fill: #333355; -fx-font-size: 20px;"/>
        </StackPane>
    </center>

    <!-- HUD sidebar -->
    <right>
        <VBox spacing="20" prefWidth="200"
              style="-fx-background-color: #16213e; -fx-padding: 24;">

            <Label text="HUD"
                   style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>

            <Separator style="-fx-background-color: #2a2a4e;"/>

            <VBox spacing="4">
                <Label text="MONEY" style="-fx-text-fill: #666688; -fx-font-size: 10px;"/>
                <Label fx:id="moneyLabel" text="\$ 10,000"
                       style="-fx-text-fill: #f0e68c; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>

            <Separator style="-fx-background-color: #2a2a4e;"/>

            <VBox spacing="4">
                <Label text="LINES" style="-fx-text-fill: #666688; -fx-font-size: 10px;"/>
                <Label fx:id="linesLabel" text="None"
                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            </VBox>

            <Separator style="-fx-background-color: #2a2a4e;"/>

            <VBox spacing="4">
                <Label text="BUILD TOOL" style="-fx-text-fill: #666688; -fx-font-size: 10px;"/>
                <Label fx:id="buildToolLabel" text="None"
                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            </VBox>

        </VBox>
    </right>

</BorderPane>
