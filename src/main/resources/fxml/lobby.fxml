<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.metrobuilder.controller.LobbyController"
           style="-fx-background-color: #1a1a2e;">

    <VBox alignment="CENTER" spacing="32" maxWidth="420">

        <Label text="METRO BUILDER"
               style="-fx-font-size: 46px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 4;"/>

        <Separator style="-fx-background-color: #4a4a8e;"/>

        <VBox spacing="14" alignment="CENTER_LEFT">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="Player"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;" minWidth="70"/>
                <TextField fx:id="usernameField" promptText="Enter name"
                           style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #4a4a8e; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 6 10;"/>
            </HBox>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="Playtime"
                       style="-fx-text-fill: #888888; -fx-font-size: 13px;" minWidth="70"/>
                <Label fx:id="playtimeLabel" text="00:00:00"
                       style="-fx-text-fill: #cccccc; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <Button text="START GAME" onAction="#onStartGame"
                style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold; -fx-padding: 14 50; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>

    </VBox>
</StackPane>
